{
	"info": {
		"name": "blog-api-test",
		"_postman_id": "blog-api-test-2026",
		"description": "企业级接口自动化测试集合：博客业务接口 + Mock下游评论接口",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "获取博客文章详情",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/posts/1",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"posts",
						"1"
					]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"// 断言1：状态码必须为200",
							"pm.test(\"状态码200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"// 断言2：业务字段校验，文章id必须等于1",
							"pm.test(\"文章id等于1\", function () {",
							"    pm.expect(pm.response.json().id).to.eql(1);",
							"});",
							"",
							"// 断言3：响应时间小于3000ms（境外免费API网络波动大，阈值放宽）",
							"pm.test(\"响应时间小于3秒\", function () {",
							"    pm.expect(pm.response.responseTime).to.be.below(3000);",
							"});"
						]
					}
				}
			]
		},
		{
			"name": "获取Mock评论列表",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{mockUrl}}/api/comments?postId=1",
					"host": [
						"{{mockUrl}}"
					],
					"path": [
						"api",
						"comments"
					],
					"query": [
						{
							"key": "postId",
							"value": "1"
						}
					]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"// 断言1：Mock接口状态码200",
							"pm.test(\"Mock接口状态码200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"// 断言2：校验Mock返回的评论内容",
							"pm.test(\"评论内容包含mock模拟数据\", function () {",
							"    pm.expect(pm.response.json()[0].body).includes(\"mock模拟的评论内容\");",
							"});",
							"",
							"// 断言3：校验评论数组长度大于0",
							"pm.test(\"评论列表有数据\", function () {",
							"    pm.expect(pm.response.json().length).greaterThan(0);",
							"});"
						]
					}
				}
			]
		}
	]
}
